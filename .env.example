# Default account used by the browser login page.
# Keep the real values in .env; never commit that file.
ICLASS_DEFAULT_STUDENT_ID=
ICLASS_DEFAULT_VPN_USERNAME=
ICLASS_DEFAULT_VPN_PASSWORD=

# Runtime network settings. Docker Compose overrides these values.
API_HOST=127.0.0.1
API_PORT=3000

# 自动签到尝试间隔（毫秒），可选，普通配置；默认 60000（每分钟）。
# 来源：按所需间隔在本机 .env 中修改此字段，然后重启后端生效。
AUTO_SIGN_POLL_INTERVAL_MS=60000
# 课表按需刷新，旧 AUTO_SIGN_SCHEDULE_REFRESH_MS 字段不再生效。

# 图片验证码 OCR 地址，可选，普通配置（非秘密）；空值关闭自动识别。
# 来源：本机部署的 OCR 服务地址。读取/修改：编辑本机 .env 后重启后端。
# Docker Compose 默认使用 http://captcha-ocr:8000/ocr；显式设置为空可关闭。
ICLASS_CAPTCHA_OCR_URL=http://captcha-ocr:8000/ocr
